{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Quirk-Systems/.github/blob/main/.quirk/schemas/dataset-card.schema.json",
  "title": "Quirk dataset card",
  "description": "Describes a dataset's origin, structure, license, classification, and intended use before anything consumes it. A card documents; it does not admit the dataset to any registry, grant training or publication rights, or prove data quality.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "dataset_id",
    "title",
    "summary",
    "status",
    "owner",
    "source",
    "collection",
    "structure",
    "license",
    "data_classification",
    "intended_use",
    "out_of_scope_use",
    "known_limitations",
    "provenance",
    "authority"
  ],
  "properties": {
    "schema_version": {"const": "dataset-card.v1"},
    "dataset_id": {"type": "string", "pattern": "^qdataset\\.[a-z0-9][a-z0-9._-]*$"},
    "title": {"type": "string", "minLength": 1, "maxLength": 200},
    "summary": {"type": "string", "minLength": 1},
    "status": {"enum": ["draft", "candidate", "maintained", "frozen", "retired"]},
    "owner": {"type": "string", "pattern": "^@[A-Za-z0-9-]+$"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit", "paths"],
      "properties": {
        "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "collection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "period", "contains_personal_data"],
      "properties": {
        "method": {"type": "string", "minLength": 1},
        "period": {"type": "string", "minLength": 1},
        "contains_personal_data": {"type": "boolean"},
        "consent_basis": {"type": ["string", "null"], "minLength": 1}
      }
    },
    "structure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "record_unit", "schema_reference", "splits", "record_count"],
      "properties": {
        "format": {"type": "string", "minLength": 1},
        "record_unit": {"type": "string", "minLength": 1},
        "schema_reference": {"type": "string", "minLength": 1},
        "splits": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "record_count": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": ["spdx", "rights_holder"],
      "properties": {
        "spdx": {"type": "string", "minLength": 1},
        "rights_holder": {"type": "string", "minLength": 1},
        "attribution": {"type": ["string", "null"], "minLength": 1}
      }
    },
    "data_classification": {"enum": ["public", "internal", "confidential", "restricted"]},
    "intended_use": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "out_of_scope_use": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "known_limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["created_at", "produced_by", "evidence_receipts"],
      "properties": {
        "created_at": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
        "produced_by": {"type": "string", "pattern": "^(@[A-Za-z0-9-]+|agent:[a-z0-9][a-z0-9-]*)$"},
        "evidence_receipts": {
          "type": "array",
          "items": {"type": "string", "pattern": "^qreceipt\\.[a-z0-9][a-z0-9._-]*$"}
        }
      }
    },
    "semantic_impact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["change_class", "concepts"],
      "properties": {
        "change_class": {"enum": ["reuse-canon", "domain-extension", "canonical-change", "projection-change", "migration"]},
        "concepts": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:\\.[a-z][a-z0-9-]*)+$"}}
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["effect", "required_next"],
      "properties": {
        "effect": {"const": "none"},
        "required_next": {
          "type": "array",
          "uniqueItems": true,
          "items": {"enum": ["review", "registry-admission", "license-clearance", "privacy-review", "publish", "none"]}
        }
      }
    }
  }
}
