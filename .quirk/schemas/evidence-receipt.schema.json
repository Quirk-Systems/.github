{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Quirk-Systems/.github/blob/main/.quirk/schemas/evidence-receipt.schema.json",
  "title": "Quirk evidence receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_id",
    "repository",
    "status",
    "subject",
    "claims",
    "artifacts",
    "verification",
    "authority",
    "correction",
    "receipt_sha256"
  ],
  "properties": {
    "schema_version": {"const": "evidence-receipt.v1"},
    "receipt_id": {"type": "string", "pattern": "^qreceipt\\.[a-z0-9][a-z0-9._-]*$"},
    "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
    "status": {"enum": ["verified", "unverified", "retracted"]},
    "subject": {"$ref": "#/$defs/subject"},
    "claims": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/claim"}},
    "artifacts": {"type": "array", "items": {"$ref": "#/$defs/artifact"}},
    "verification": {"$ref": "#/$defs/verification"},
    "authority": {"$ref": "#/$defs/authority"},
    "correction": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/correction"}]},
    "receipt_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "verified"}}, "required": ["status"]},
      "then": {
        "properties": {
          "subject": {"properties": {"changed_paths": {"minItems": 1}}},
          "claims": {
            "items": {"properties": {"evidence_paths": {"minItems": 1}}}
          },
          "artifacts": {"minItems": 1},
          "verification": {
            "properties": {
              "commands": {
                "minItems": 1,
                "items": {
                  "properties": {
                    "result": {"const": "pass"},
                    "exit_code": {"const": 0}
                  }
                }
              }
            }
          },
          "correction": {"type": "null"}
        }
      },
      "else": {"properties": {"correction": {"$ref": "#/$defs/correction"}}}
    }
  ],
  "$defs": {
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base_commit", "commit", "changed_paths"],
      "properties": {
        "base_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "changed_paths": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim_id", "claim_type", "authority_effect", "statement", "evidence_paths"],
      "properties": {
        "claim_id": {"type": "string", "pattern": "^qclaim\\.[a-z0-9][a-z0-9._-]*$"},
        "claim_type": {
          "enum": ["implementation", "test", "documentation", "governance", "evidence", "correction"]
        },
        "authority_effect": {"const": "none"},
        "statement": {"type": "string", "minLength": 1},
        "evidence_paths": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "state", "git_blob", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "state": {"enum": ["present", "deleted"]},
        "git_blob": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"},
        "sha256": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"}
      },
      "allOf": [
        {
          "if": {"properties": {"state": {"const": "present"}}, "required": ["state"]},
          "then": {
            "properties": {
              "git_blob": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
              "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
            }
          },
          "else": {
            "properties": {"git_blob": {"type": "null"}, "sha256": {"type": "null"}}
          }
        }
      ]
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "result", "exit_code"],
      "properties": {
        "command": {"type": "string", "minLength": 1},
        "result": {"enum": ["pass", "fail"]},
        "exit_code": {"type": "integer"}
      },
      "allOf": [
        {
          "if": {"properties": {"result": {"const": "pass"}}, "required": ["result"]},
          "then": {"properties": {"exit_code": {"const": 0}}},
          "else": {"properties": {"exit_code": {"not": {"const": 0}}}}
        }
      ]
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commands", "verified_at"],
      "properties": {
        "commands": {"type": "array", "items": {"$ref": "#/$defs/command"}},
        "verified_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]+)?Z$"
        }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["admission_effect", "authority_ref"],
      "properties": {
        "admission_effect": {"const": "none"},
        "authority_ref": {"type": ["string", "null"], "minLength": 1}
      }
    },
    "correction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason", "external_claim_refs", "observations"],
      "properties": {
        "reason": {"type": "string", "minLength": 1},
        "external_claim_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "observations": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
