{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Quirk-Systems/.github/blob/main/.quirk/schemas/agent-task.schema.json",
  "title": "Quirk agent task contract",
  "description": "Machine-readable form of the agent-governance requirements in docs/REPOSITORY_STRATEGY.md section 8.8: bounded objective, allowed and forbidden knowledge sources, allowed, approval-gated, and forbidden tools, execution environment and limits, human owner and shutdown authority, required evidence, model identity, and a rollback plan. A task record describes work; it grants no permission and its authority effect is always none. Closed object.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "repository",
    "title",
    "status",
    "subject",
    "objective",
    "knowledge_sources",
    "tools",
    "execution",
    "owner",
    "agent",
    "evidence",
    "rollback",
    "authority",
    "idempotency_key",
    "residue"
  ],
  "properties": {
    "schema_version": {"const": "agent-task.v1"},
    "task_id": {"type": "string", "pattern": "^qtask\\.[a-z0-9][a-z0-9._-]*$"},
    "repository": {"type": "string", "pattern": "^Quirk-Systems/[A-Za-z0-9_.-]+$"},
    "title": {"type": "string", "minLength": 1, "maxLength": 200},
    "status": {"enum": ["proposed", "authorized", "running", "blocked", "completed", "abandoned"]},
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base_commit", "issue"],
      "properties": {
        "base_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "issue": {"type": ["integer", "null"], "minimum": 1}
      }
    },
    "objective": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "allowed_paths", "forbidden_paths"],
      "properties": {
        "outcome": {"type": "string", "minLength": 1},
        "allowed_paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "forbidden_paths": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "knowledge_sources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed", "forbidden"],
      "properties": {
        "allowed": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "forbidden": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "tools": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed", "approval_gated", "forbidden"],
      "properties": {
        "allowed": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "approval_gated": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "forbidden": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["environment", "max_runtime_minutes", "max_files_changed", "network"],
      "properties": {
        "environment": {"type": "string", "minLength": 1},
        "max_runtime_minutes": {"type": "integer", "minimum": 1},
        "max_files_changed": {"type": "integer", "minimum": 1},
        "network": {"enum": ["none", "package-registries", "github-only", "allowlist", "unrestricted"]}
      }
    },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["human", "shutdown_authority"],
      "properties": {
        "human": {"type": "string", "pattern": "^@[A-Za-z0-9-]+$"},
        "shutdown_authority": {"type": "string", "pattern": "^@[A-Za-z0-9-]+$"}
      }
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "model"],
      "properties": {
        "profile": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "model": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["provider", "identifier"],
          "properties": {
            "provider": {"type": "string", "minLength": 1},
            "identifier": {"type": "string", "minLength": 1},
            "version": {"type": ["string", "null"], "minLength": 1}
          }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verification_commands", "receipt_required"],
      "properties": {
        "verification_commands": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "receipt_required": {"type": "boolean"}
      }
    },
    "rollback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plan", "reversible"],
      "properties": {
        "plan": {"type": "string", "minLength": 1},
        "reversible": {"type": "boolean"}
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["effect", "required_next"],
      "properties": {
        "effect": {"const": "none"},
        "required_next": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["authorize", "review", "merge", "canon", "release", "deploy", "publish"]}
        }
      }
    },
    "idempotency_key": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "residue": {"type": "array", "items": {"type": "string", "minLength": 1}}
  }
}
