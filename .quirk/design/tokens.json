{
  "$schema": "https://github.com/Quirk-Systems/.github/blob/main/.quirk/schemas/design-tokens.schema.json",
  "$description": "Quirk seed design tokens. Candidate values: the structure and naming are the contract; Quirk-Systems/quirk-design owns the visual decisions and may replace every value through a reviewed change. Projections (CSS variables, Tailwind theme, Figma variables) are generated by scripts/design_tokens.py and never edited by hand.",
  "$extensions": {
    "quirk": {
      "status": "candidate",
      "version": "0.1.0",
      "implementation_owner": "Quirk-Systems/quirk-design",
      "authority_effect": "none"
    }
  },
  "color": {
    "$type": "color",
    "ink": {
      "$value": "#141210",
      "$description": "Primary text on paper surfaces."
    },
    "ink-muted": {
      "$value": "#5c5852",
      "$description": "Secondary text and metadata."
    },
    "paper": {
      "$value": "#f7f4ee",
      "$description": "Default light surface."
    },
    "paper-raised": {
      "$value": "#ffffff",
      "$description": "Cards and panels on paper."
    },
    "slate": {
      "$value": "#1b1d21",
      "$description": "Default dark surface."
    },
    "slate-raised": {
      "$value": "#26292f",
      "$description": "Cards and panels on slate."
    },
    "signal": {
      "$value": "#c8451f",
      "$description": "The one accent. Actions, links, and emphasis. Never decorative."
    },
    "signal-soft": {
      "$value": "#f3d9cf",
      "$description": "Accent wash for selected or highlighted regions."
    },
    "verify": {
      "$value": "#2f6f4e",
      "$description": "VERIFIED state."
    },
    "infer": {
      "$value": "#8a6d1f",
      "$description": "INFERRED state."
    },
    "unknown": {
      "$value": "#6b6f7a",
      "$description": "UNKNOWN state."
    },
    "text": {
      "default": {"$value": "{color.ink}"},
      "muted": {"$value": "{color.ink-muted}"},
      "on-signal": {"$value": "{color.paper-raised}"}
    },
    "surface": {
      "default": {"$value": "{color.paper}"},
      "raised": {"$value": "{color.paper-raised}"}
    }
  },
  "space": {
    "$type": "dimension",
    "$description": "4px base scale.",
    "1": {"$value": {"value": 4, "unit": "px"}},
    "2": {"$value": {"value": 8, "unit": "px"}},
    "3": {"$value": {"value": 12, "unit": "px"}},
    "4": {"$value": {"value": 16, "unit": "px"}},
    "6": {"$value": {"value": 24, "unit": "px"}},
    "8": {"$value": {"value": 32, "unit": "px"}},
    "12": {"$value": {"value": 48, "unit": "px"}},
    "16": {"$value": {"value": 64, "unit": "px"}}
  },
  "radius": {
    "$type": "dimension",
    "sharp": {"$value": {"value": 2, "unit": "px"}},
    "soft": {"$value": {"value": 6, "unit": "px"}},
    "round": {"$value": {"value": 999, "unit": "px"}}
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "text": {"$value": ["Inter", "system-ui", "sans-serif"]},
      "mono": {"$value": ["JetBrains Mono", "ui-monospace", "monospace"]}
    },
    "weight": {
      "$type": "fontWeight",
      "regular": {"$value": 400},
      "medium": {"$value": 500},
      "bold": {"$value": 700}
    },
    "size": {
      "$type": "dimension",
      "xs": {"$value": {"value": 12, "unit": "px"}},
      "sm": {"$value": {"value": 14, "unit": "px"}},
      "md": {"$value": {"value": 16, "unit": "px"}},
      "lg": {"$value": {"value": 20, "unit": "px"}},
      "xl": {"$value": {"value": 28, "unit": "px"}},
      "display": {"$value": {"value": 40, "unit": "px"}}
    },
    "leading": {
      "$type": "number",
      "tight": {"$value": 1.2},
      "text": {"$value": 1.5}
    }
  },
  "motion": {
    "duration": {
      "$type": "duration",
      "quick": {"$value": {"value": 120, "unit": "ms"}},
      "settle": {"$value": {"value": 240, "unit": "ms"}}
    },
    "ease": {
      "$type": "cubicBezier",
      "standard": {"$value": [0.2, 0, 0, 1]},
      "exit": {"$value": [0.4, 0, 1, 1]}
    }
  }
}
