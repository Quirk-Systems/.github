    {
      "claim_id": "qclaim.reusable-caller-permissions.c2b321a15deb",
      "claim_type": "evidence",
      "authority_effect": "none",
      "statement": "No reusable workflow in this repository names a top-level permission scope that none of its jobs uses: where every job names its own scopes the top-level block is 'permissions: {}', and where a job names none the block is exactly what that job gets. tests/test_workflow_pins.py enforces this and a fixture test pins the parser to the three permission shapes. VERIFIED at this commit: 160 tests pass under Python 3.12, ruff reports no issues, actionlint reports nothing, and zizmor --offline --persona pedantic reports no findings with 24 ignored, unchanged from the base. INFERRED from two observed hosted runs of the same caller across two pins: GitHub validates a called workflow's top-level permissions block against the caller job's grant before creating any job. UNKNOWN until a hosted run is observed: whether a caller granting only the scopes a job names now compiles.",
      "evidence_paths": [
        ".github/workflows/reusable-codeql.yml",
        ".github/workflows/reusable-pr-title-lint.yml",
